# ═══════════════════════════════════════════════════════════════
# Populatrs — Configuration example
# Copy to populatrs.env and adjust to your environment
# ═══════════════════════════════════════════════════════════════

# ─── Network ───────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=3044

# ─── Data ──────────────────────────────────────────────────
# DATA_DIR=./data
# DATABASE_URL=./data/populatrs.db

# ─── Scheduler ─────────────────────────────────────────────
# TIMEZONE=UTC

# ─── Logging ───────────────────────────────────────────────
# RUST_LOG=info
# LOG_FORMAT=pretty

# ─── OIDC (PocketID) — requerido en producción ────────────
# OIDC_ISSUER_URL=https://pocketid.example.com
# OIDC_CLIENT_ID=populatrs
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=http://localhost:3044/auth/callback