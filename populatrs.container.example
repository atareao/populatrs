[Unit]
Description=Populatrs RSS Feed Publisher

[Container]
Image=docker.io/atareao/populatrs:latest
EnvironmentFile=%h/populatrs/populatrs.env
Volume=%h/populatrs/data:/app/data:Z
PublishPort=3044:3044
HealthCmd=wget --no-verbose --tries=1 --spider http://localhost:3044/health || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=10s

[Install]
WantedBy=default.target